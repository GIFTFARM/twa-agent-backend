# --- Server ---
PORT=3000
WEBAPP_URL=https://your-frontend.vercel.app

# --- Telegram bot ---
# Get from @BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram numeric user id (from @userinfobot)
ADMIN_TELEGRAM_ID=

# --- Postgres ---
# On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/db

# --- Encryption ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Defaults for new admin-added providers ---
# Pre-seeded if DB empty. Users normally add via /admin in WebApp.
